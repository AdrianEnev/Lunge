{
    "compilerOptions": {
      "target": "ES6",
      "module": "commonjs",
      "outDir": "./dist",
      "rootDir": "./",
      "strict": true,
      "esModuleInterop": true,
      "allowJs": true,
      "checkJs": false,
      "resolveJsonModule": true,
      "baseUrl": ".",
      "paths": {
        "@custom_errors/*": ["errors/custom_errors/*"],
        "@config/*": ["config/*"],
        "@middleware/*": ["middleware/*"],
        "@routes/*": ["routes/*"],
        "@services/*": ["services/*"],
        "@utils/*": ["utils/*"]
      }
    },
    "include": ["**/*"],
    "exclude": ["node_modules"],
    "ts-node": {
      "files": true
    }
  }